{
  "name": "assistfin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "test": "tsx scripts/test-app.mts && tsx scripts/test-assistant.mts",
    "test:core": "tsx scripts/test-app.mts",
    "test:assistant": "tsx scripts/test-assistant.mts",
    "test:calendario": "for d in 2026-11-12 2026-10-28 2026-11-21 2026-11-30 2026-12-31 2027-02-28; do echo \"## ASSISTFIN_TODAY=$d\"; ASSISTFIN_TODAY=$d tsx scripts/test-assistant.mts || exit 1; done",
    "test:assistant:remote": "tsx scripts/test-assistant-remote.mts",
    "test:money": "node --experimental-strip-types scripts/test-money.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:api": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.api.json",
    "eval:models": "tsx scripts/eval-assistant-models.mts",
    "probe:redteam": "tsx scripts/probe-redteam.mts",
    "rubric": "tsx scripts/rubric-assistant.mts"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
