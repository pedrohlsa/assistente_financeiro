# Backend de IA (DeepSeek) — variáveis server-only, SEM prefixo VITE_.
# Nunca são lidas por código do frontend (src/**); só por vite.config.ts (dev)
# e api/ai/chat.ts (produção/Vercel), via api/_lib/deepseek.ts.
#
# Copie para .env (git-ignored) e preencha DEEPSEEK_API_KEY com sua chave real.
# Em produção, cadastre as mesmas variáveis no dashboard/CLI da Vercel.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
